# 🌐 AgentManager Environment Template
# Copy this to .env and fill in the values.

# 📂 Data Layer Configuration
# Path to your private agent-data repository (where memory and status are stored)
AGENT_DATA_ROOT=$HOME/agent-data
AGENT_DATA_DIR=$AGENT_DATA_ROOT

# Runtime role: CORE runs background services; CLIENT only reads/syncs memory.
AGENT_MODE=CLIENT

# 🔑 Secrets & Tokens
# Your GitHub Personal Access Token (with repo scope)
GITHUB_TOKEN=your_github_token_here

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Authorized Telegram Channel/User ID
TELEGRAM_CHANNEL_ID=your_telegram_id_here

# 🧠 AI Configuration
# Gemini API Key (if using the bot bridge)
GEMINI_API_KEY=your_gemini_api_key_here

# Remote AI proxy base URL used by agent_core/ai_client.py
AI_API_BASE_URL=https://ai-api.myacademia.uk
# Remote AI proxy token used by LiteLLM proxy upstream calls
AI_API_ACADEMIA_KEY=your_ai_api_academia_key_here
# Default output budget for helper clients that do not set max_tokens explicitly
AI_DEFAULT_MAX_TOKENS=256

# 📡 Command Center
# The GitHub repository for your AI Command Center
COMMAND_CENTER_REPO=alstonhuang/AI_Command_Center

# 🌐 Distributed AgentOS Control Plane (CORE only)
# Keep the gateway on loopback and expose it through an authenticated HTTPS reverse proxy/tunnel.
AGENTOS_CONTROL_PLANE_HOST=127.0.0.1
AGENTOS_CONTROL_PLANE_PORT=8765
AGENTOS_CONTROL_PLANE_PUBLIC_URL=https://agentos.example.com
# Shared MVP bearer token for authorized runtime/gateway clients. Replace with a strong secret.
AGENTOS_CONTROL_PLANE_TOKEN=replace_with_strong_control_plane_token
# Optional explicit SQLite path; defaults to $AGENT_DATA_ROOT/runtime/control-plane.sqlite3
# AGENTOS_CONTROL_PLANE_DB=$AGENT_DATA_ROOT/runtime/control-plane.sqlite3

# 🚚 Distributed Runtime Dispatcher
# Token used by the Core to call GitHub workflow_dispatch. Keep separate from GITHUB_TOKEN when possible.
AGENTOS_GITHUB_TOKEN=replace_with_actions_write_token
AGENTOS_GITHUB_REPOSITORY=alston-personal/agentmanager
AGENTOS_GITHUB_WORKFLOW=distributed-agentos-worker.yml
AGENTOS_GITHUB_REF=main
AGENTOS_GITHUB_RUNTIME_ID=github-actions-worker
# Only explicitly registered capabilities can be dispatched to GitHub Actions.
AGENTOS_GITHUB_CAPABILITIES=agentos.ir.validate
AGENTOS_GITHUB_PRIORITY=100
AGENTOS_DISPATCH_INTERVAL_SECONDS=5
AGENTOS_DISPATCH_LIMIT=100

# 🧠 Advanced (Optional)
# Path to the Antigravity Knowledge Base
ANTIGRAVITY_DIR=$HOME/.gemini/antigravity
KNOWLEDGE_ROOT=$ANTIGRAVITY_DIR/knowledge

# 🖥️ Continue IDE (VSCode/Cursor plugin) - referenced in ~/.continue/config.yaml
# Gemini key for Continue chat/autocomplete
CONTINUE_GEMINI_API_KEY=your_gemini_api_key_here
# Qwen or other custom Ollama endpoint key (if applicable)
CONTINUE_QWEN_API_KEY=your_qwen_api_key_here
