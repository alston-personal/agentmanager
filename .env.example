# 🌐 AgentManager Environment Template
# Copy this to .env and fill in the values.

# 📂 Data Layer Configuration
# Path to your private agent-data repository (where memory and status are stored)
AGENT_DATA_ROOT=$HOME/agent-data
AGENT_DATA_DIR=$AGENT_DATA_ROOT

# Runtime role: CORE runs background services; CLIENT only reads/syncs memory.
AGENT_MODE=CLIENT

# 🔑 Secrets & Tokens
# Your GitHub Personal Access Token (with repo scope)
GITHUB_TOKEN=your_github_token_here

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Authorized Telegram Channel/User ID
TELEGRAM_CHANNEL_ID=your_telegram_id_here

# 🧠 AI Configuration
# OpenAI API key for Provider Bridge routes using openai_responses.
OPENAI_API_KEY=your_openai_api_key_here
# Gemini API/auth key for Provider Bridge or bot bridge routes.
GEMINI_API_KEY=your_gemini_api_key_here

# Remote AI proxy base URL used by agent_core/ai_client.py and optional openai_chat provider routes.
AI_API_BASE_URL=https://ai-api.myacademia.uk/v1
# Remote AI proxy token used by LiteLLM proxy upstream calls
AI_API_ACADEMIA_KEY=your_ai_api_academia_key_here
# Default output budget for helper clients that do not set max_tokens explicitly
AI_DEFAULT_MAX_TOKENS=256

# 📡 Command Center
# The GitHub repository for your AI Command Center
COMMAND_CENTER_REPO=alstonhuang/AI_Command_Center

# 🌐 Distributed AgentOS Control Plane (CORE only)
# Service installer keeps Distributed AgentOS disabled until this is explicitly set to 1.
AGENTOS_DISTRIBUTED_SERVICES_ENABLED=0
# Provider Bridge can be enabled independently after the Control Plane is healthy and provider credentials are ready.
AGENTOS_PROVIDER_BRIDGE_ENABLED=0
# Keep the gateway on loopback and expose it through an authenticated HTTPS reverse proxy/tunnel.
AGENTOS_CONTROL_PLANE_HOST=127.0.0.1
AGENTOS_CONTROL_PLANE_PORT=8765
AGENTOS_CONTROL_PLANE_PUBLIC_URL=https://agentos.example.com
# Shared MVP bearer token for authorized runtime/gateway clients. Replace with a strong secret.
AGENTOS_CONTROL_PLANE_TOKEN=replace_with_strong_control_plane_token
# Optional explicit SQLite path; defaults to $AGENT_DATA_ROOT/runtime/control-plane.sqlite3
# AGENTOS_CONTROL_PLANE_DB=$AGENT_DATA_ROOT/runtime/control-plane.sqlite3
# Optional cross-IDE defaults. A committed .agentos/project.json is preferred for stable project identity.
# AGENTOS_PROJECT_ID=agentmanager
AGENTOS_DEFAULT_CAPABILITY=agent.reason

# 🚚 Distributed Runtime Dispatcher
# Token used by the Core to call GitHub workflow_dispatch. Keep separate from GITHUB_TOKEN when possible.
AGENTOS_GITHUB_TOKEN=replace_with_actions_write_token
AGENTOS_GITHUB_REPOSITORY=alston-personal/agentmanager
AGENTOS_GITHUB_WORKFLOW=distributed-agentos-worker.yml
AGENTOS_GITHUB_REF=main
AGENTOS_GITHUB_RUNTIME_ID=github-actions-worker
# Only explicitly registered capabilities can be dispatched to GitHub Actions.
AGENTOS_GITHUB_CAPABILITIES=agentos.ir.validate
AGENTOS_GITHUB_PRIORITY=100
AGENTOS_DISPATCH_INTERVAL_SECONDS=5
AGENTOS_DISPATCH_LIMIT=100

# 🤖 Agent Provider Bridge
# Core -> Bridge wake endpoint. Loopback HTTP is allowed; remote endpoints should be HTTPS.
AGENTOS_PROVIDER_BRIDGE_ENDPOINT=http://127.0.0.1:8775/v1/runtime-dispatch
# Shared bearer token protecting the Bridge wake endpoint.
AGENTOS_PROVIDER_BRIDGE_TOKEN=replace_with_strong_provider_bridge_token
# Stable runtime identity used for exact task lease/complete.
AGENTOS_PROVIDER_RUNTIME_ID=provider-bridge
# Union of capabilities advertised by routes in AGENTOS_PROVIDER_ROUTES_FILE/JSON.
AGENTOS_PROVIDER_CAPABILITIES=ai.reason,ai.synthesize,ai.verify,ai.research,code.implement,code.review,web.chatgpt
AGENTOS_PROVIDER_PRIORITY=50
AGENTOS_PROVIDER_BRIDGE_HOST=127.0.0.1
AGENTOS_PROVIDER_BRIDGE_PORT=8775
AGENTOS_PROVIDER_ROUTES_FILE=config/provider-routes.example.json
# Alternative: inline non-secret route array instead of a file.
# AGENTOS_PROVIDER_ROUTES_JSON=[]
AGENTOS_PROVIDER_LEASE_SECONDS=300
AGENTOS_PROVIDER_MAX_WORKERS=4
# Optional secret used only by a relay_webhook route that references token_env=CHATGPT_RELAY_TOKEN.
CHATGPT_RELAY_TOKEN=replace_with_browser_relay_token

# 📮 Private continuity mirror (optional but recommended for connector-only agents)
# The Control Plane remains authoritative. This mirror writes a compact latest.json checkpoint
# so ChatGPT/GitHub-connected agents can read project continuity without Control Plane credentials.
AGENTOS_CONTINUITY_MIRROR_REPOSITORY=alston-personal/my-agent-data
AGENTOS_CONTINUITY_MIRROR_BRANCH=main
AGENTOS_CONTINUITY_MIRROR_ROOT=projects
# Separate token with Contents: read/write on the PRIVATE data repo. Never place this token in Canonical IR.
AGENTOS_CONTINUITY_MIRROR_TOKEN=replace_with_private_data_repo_contents_token

# 🧠 Advanced (Optional)
# Path to the Antigravity Knowledge Base
ANTIGRAVITY_DIR=$HOME/.gemini/antigravity
KNOWLEDGE_ROOT=$ANTIGRAVITY_DIR/knowledge

# 🖥️ Continue IDE (VSCode/Cursor plugin) - referenced in ~/.continue/config.yaml
# Gemini key for Continue chat/autocomplete
CONTINUE_GEMINI_API_KEY=your_gemini_api_key_here
# Qwen or other custom Ollama endpoint key (if applicable)
CONTINUE_QWEN_API_KEY=your_qwen_api_key_here
