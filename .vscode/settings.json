{
  "files.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/.venv": true,
    "**/.git": true,
    "workspace/": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/.venv": true,
    "workspace/": true
  },
  "claudeCode.environmentVariables": [
    {
      "name": "ANTHROPIC_BASE_URL",
      "value": "http://127.0.0.1:4000"
    },
    {
      "name": "ANTHROPIC_API_KEY",
      "value": "sk-dummy"
    },
    {
      "name": "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY",
      "value": "1"
    }
  ],
  "git.ignoredRepositories": [
    "/tmp",
    "/tmp/*",
    "/home/ubuntu/agent-data/releases",
    "/home/ubuntu/agent-data/employee-worker-state",
    "/home/ubuntu/.local/share/agentos-core-releases"
  ],
  "git.autoRepositoryDetection": "openEditors",
  "git.repositoryScanMaxDepth": 1
}
