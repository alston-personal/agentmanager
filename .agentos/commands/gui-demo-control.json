{
  "schema": "agentos.gui-demo-command/v0.1",
  "node_id": "VO10005870",
  "nonce": "desktop-demo-winget-probe-007",
  "action": "shell.exec",
  "payload": {
    "executable": "powershell",
    "argv": [
      "-NoProfile",
      "-NonInteractive",
      "-Command",
      "$w=Get-Command winget -ErrorAction SilentlyContinue; if($w){[pscustomobject]@{winget=$w.Source;version=(& winget --version)}|ConvertTo-Json -Compress}else{'{\"winget\":null}'}"
    ],
    "timeout_seconds": 20
  }
}
