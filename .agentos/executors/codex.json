{
  "schema": "agentos.executor-provider-profile/v0.1",
  "executor_id": "codex",
  "provider_id": "openai",
  "executor_class": "codex",
  "modes": [
    "cli"
  ],
  "owner": "provider-adapter",
  "capabilities": [
    "agent.chat",
    "code.edit"
  ],
  "discovery": {
    "strategy": [
      "provider_adapter"
    ],
    "provider_owned_allowlists_only": true,
    "credential_access": false
  },
  "readiness": {
    "dimensions": [
      "installed",
      "reachable",
      "authorized",
      "routable",
      "healthy"
    ],
    "ready_requires": [
      "installed",
      "reachable",
      "authorized",
      "routable",
      "healthy"
    ]
  },
  "invocation": {
    "bounded_semantic_requests_only": true,
    "caller_supplied_executable": false,
    "caller_supplied_argv": false,
    "caller_supplied_env": false
  },
  "cancellation": {
    "supported": false,
    "strategy": "provider-defined"
  },
  "concurrency": {
    "model": "single_process",
    "mutex_scope": "codex"
  },
  "receipt": {
    "required": true,
    "secrets_allowed": false
  },
  "smoke": {
    "required": true,
    "kind": "provider-health-model-probe",
    "expected_safe_evidence": [
      "installed",
      "authorized",
      "healthy",
      "classification"
    ]
  },
  "adoption": {
    "reinstall_by_default": false,
    "preserve_existing_identity": true
  },
  "implementation": {
    "adapter_module": "agentos_node.codex_provider_adapter:CodexProvider",
    "notes": "Provider-owned Codex CLI adapter: PATH/known-location discovery, login status, bounded real-model health probe, semantic invoke, sanitized receipt."
  }
}
