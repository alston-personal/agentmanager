[Unit]
Description=AgentOS Shared Employee Worker Host (system resource boundary)
After=network.target
Wants=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
SupplementaryGroups=agentos
WorkingDirectory=/home/ubuntu/agent-data/runtime/core/current
EnvironmentFile=/home/ubuntu/.config/agentos/employee-worker-host.env
ExecStart=/usr/bin/python3 -m agentos_node.employee_worker_host_daemon
Restart=always
RestartSec=5
CPUQuota=50%
CPUWeight=20
IOWeight=20
MemoryMax=1G
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/agent-data/employee-runtime /home/ubuntu/agent-data/employee-worker-host /home/ubuntu/agent-data/employee-worker-state

[Install]
WantedBy=multi-user.target
