# Non-secret shared Employee Worker Host configuration.
# Repository merge does not install/enable this service.
# Host activation remains a separate governed runtime mutation.

AGENTOS_EMPLOYEE_RUNTIME_ROOT=/home/ubuntu/agent-data/employee-runtime
AGENTOS_EMPLOYEE_WAKE_ROOT=/home/ubuntu/agent-data/employee-wake-inbox
AGENTOS_EMPLOYEE_WORKER_HOST_STATE_ROOT=/home/ubuntu/agent-data/employee-worker-host
AGENTOS_EMPLOYEE_WORKER_STATE_ROOT=/home/ubuntu/agent-data/employee-worker-state
AGENTOS_EMPLOYEE_WORKER_NODE_ID=oracle-core
AGENTOS_EMPLOYEE_WORKER_POLL_SECONDS=2
AGENTOS_EMPLOYEE_WORKER_CHILD_TIMEOUT_SECONDS=180
AGENTOS_EMPLOYEE_WORKER_LEASE_SECONDS=60
