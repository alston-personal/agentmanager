[Unit]
Description=AgentOS Paw Trusted Issuer (explicit owner-approved lease only)
After=local-fs.target
ConditionPathExists=/etc/agentos/paw-issuer/approval.json
ConditionPathExists=/etc/agentos/paw-issuer/ed25519.key

[Service]
Type=oneshot
User=agentos-issuer
Group=agentos-issuer
WorkingDirectory=/home/ubuntu/agent-data/runtime/core/current
StateDirectory=agentos-paw-issuer
StateDirectoryMode=0700
LoadCredential=approved-request:/etc/agentos/paw-issuer/approval.json
LoadCredential=signing-key:/etc/agentos/paw-issuer/ed25519.key
ExecStart=/home/ubuntu/agent-data/runtime/core/current/.venv/bin/python3 -m agentos_node.paw_trusted_issuer_cli --approval ${CREDENTIALS_DIRECTORY}/approved-request --private-key ${CREDENTIALS_DIRECTORY}/signing-key --issuer-outbox /var/lib/agentos-paw-issuer --runtime-root /home/ubuntu/agent-data/employee-runtime --registry-path /home/ubuntu/agent-data/runtime/core/current/governance/execution-authority.json
NoNewPrivileges=true
UMask=0077
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/ubuntu/agent-data/employee-runtime
ReadWritePaths=/var/lib/agentos-paw-issuer
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
LockPersonality=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

# Deliberately no [Install]: never enable as a generic automatic issuer.
# Owner approval and the immutable release/deployment gate are prerequisites.
