    },
    "agentos-core": {
      "owner": "role://release-controller.core",
      "release_root": "/home/ubuntu/agent-data/releases/core",
      "live_pointer": "/home/ubuntu/agent-data/runtime/core/current",
      "lock": "production/agentos-core",
      "migration_state": "partial",
      "authority_contract": "docs/CORE_DEPLOYMENT_AUTHORITY.md"
