  "invariants": [
    "a production service is deployed from an immutable release directory, never inferred from shared checkout HEAD",
    "only the declared release controller may switch a service live pointer",
    "one service lock cannot be held by two deployment generations",
    "cross-service changes require explicit impact declaration and consumer acceptance",
    "rollback changes only the affected service live pointer/release, never another service checkout"
  ]
